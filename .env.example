PORT=8787
SOLVEA_FISCAL_MODE=development
SOLVEA_FISCAL_API_TOKEN=change-me

# Para sandbox real usar SOLVEA_FISCAL_MODE=certification y un directorio persistente.
SOLVEA_FISCAL_STATE_DIR=
SII_TIME_ZONE=America/Santiago

# Las llamadas reales al SII están deshabilitadas por defecto.
# Cambiar a true únicamente al probar el ambiente de certificación.
SII_NETWORK_ENABLED=false

# Dejarlas vacías usa automáticamente los endpoints del modo configurado:
# certification -> https://apicert.sii.cl/recursos/v1 y https://pangal.sii.cl/recursos/v1
# production    -> https://api.sii.cl/recursos/v1 y https://rahue.sii.cl/recursos/v1
SII_AUTH_BASE_URL=
SII_BOLETA_BASE_URL=
SII_HTTP_TIMEOUT_MS=15000

# Carátula y multipart del envío.
SII_RUT_ENVIA=
SII_RUT_RECEPTOR=60803000-K
SII_FCH_RESOL=
# Usar el valor que corresponda al contribuyente/ambiente de certificación.
SII_NRO_RESOL=

# Datos del emisor certificado. En este proyecto corresponden al contribuyente de Botillería San Pablo.
SII_RUT_EMISOR=
SII_RAZON_SOCIAL=
SII_GIRO=
SII_DIRECCION_ORIGEN=
SII_COMUNA_ORIGEN=CONSTITUCION
SII_CIUDAD_ORIGEN=CONSTITUCION
SII_CODIGO_SUCURSAL=

# Certificado digital PKCS#12/PFX completo codificado en Base64.
# Nunca subir el PFX ni su contraseña al repositorio.
SII_CERT_PFX_BASE64=
SII_CERT_PASSWORD=

# XML AUTORIZACION completo del CAF de certificación, codificado en Base64.
# Nunca subir los CAF al repositorio: contienen la llave privada de timbraje.
SII_CAF_39_XML_BASE64=
SII_CAF_41_XML_BASE64=
