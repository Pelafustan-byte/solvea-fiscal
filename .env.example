PORT=8787
SOLVEA_FISCAL_MODE=development
SOLVEA_FISCAL_API_TOKEN=change-me

# Desarrollo puede usar memoria. Para certificación, apuntar a un directorio persistente.
SOLVEA_FISCAL_STATE_DIR=
SII_TIME_ZONE=America/Santiago

# Las llamadas reales al SII están deshabilitadas por defecto.
SII_NETWORK_ENABLED=false
# Autenticación: apicert certificación / api producción.
SII_AUTH_BASE_URL=
# Boletas: pangal certificación / rahue producción.
SII_BOLETA_BASE_URL=
SII_HTTP_TIMEOUT_MS=15000

# Carátula y multipart del envío.
SII_RUT_ENVIA=
SII_RUT_RECEPTOR=60803000-K
SII_FCH_RESOL=
# En certificación normalmente el número informado por el proceso es 0; usar el dato que corresponda al contribuyente/ambiente.
SII_NRO_RESOL=

# Datos del emisor. En Botillería San Pablo deben corresponder al contribuyente certificado.
SII_RUT_EMISOR=
SII_RAZON_SOCIAL=
SII_GIRO=
SII_DIRECCION_ORIGEN=
SII_COMUNA_ORIGEN=CONSTITUCION
SII_CIUDAD_ORIGEN=CONSTITUCION
SII_CODIGO_SUCURSAL=

# Certificado digital PKCS#12/PFX completo codificado en Base64.
SII_CERT_PFX_BASE64=
SII_CERT_PASSWORD=

# XML AUTORIZACION completo del CAF, codificado en Base64.
SII_CAF_39_XML_BASE64=
SII_CAF_41_XML_BASE64=
