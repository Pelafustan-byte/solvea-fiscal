PORT=8787
SOLVEA_FISCAL_MODE=development
SOLVEA_FISCAL_API_TOKEN=change-me

# Desarrollo puede usar memoria. Para certificación, apuntar a un directorio persistente.
SOLVEA_FISCAL_STATE_DIR=

# El SII usa fecha/hora local del emisor en FE/TSTED.
SII_TIME_ZONE=America/Santiago

# Datos del emisor. En Botillería San Pablo deben corresponder al contribuyente certificado.
SII_RUT_EMISOR=
SII_RAZON_SOCIAL=
SII_GIRO=
SII_DIRECCION_ORIGEN=
SII_COMUNA_ORIGEN=CONSTITUCION
SII_CIUDAD_ORIGEN=CONSTITUCION
SII_CODIGO_SUCURSAL=

# Certificado digital: se utilizará en la próxima fase para firma XMLDSIG/autenticación SII.
SII_CERT_PFX_BASE64=
SII_CERT_PASSWORD=

# XML AUTORIZACION completo del CAF, codificado en Base64.
# Nunca subir los CAF al repositorio: contienen la llave privada de timbraje.
SII_CAF_39_XML_BASE64=
SII_CAF_41_XML_BASE64=
